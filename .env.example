# Privearch Environment Configuration Template
# Copy to .env and configure as needed for your local workstation

# Local Model Paths (GGUF / Llama-cpp)
ROUTER_MODEL_PATH=models/qwen2.5-0.5b-instruct-q4_k_m.gguf
SYNTHESIS_MODEL_PATH=models/qwen2.5-coder-7b-instruct-q4_k_m.gguf

# Embedding Configuration
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
DEVICE=cpu

# Hardware Allocation
NUM_CPU_THREADS=8
GPU_LAYERS=0
CONTEXT_WINDOW=4096

# Knowledge Vault Directories
DATASETS_DIR=datasets
KNOWLEDGE_DIR=knowledge
LOGS_DIR=logs
