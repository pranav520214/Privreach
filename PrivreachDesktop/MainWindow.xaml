<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PrivreachDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PrivreachDesktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Privreach OS — Zero-Trust Scientific Workstation"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OpenCommandPalette_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Privreach OS — Zero-Trust Scientific Workstation">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Main Workspace Frame -->
        <Frame x:Name="RootFrame" Grid.Row="1" />

        <!-- Ctrl+K Command Palette Dialog -->
        <ContentDialog x:Name="CommandPaletteDialog"
                       Title="⚡ Privreach Command Palette"
                       PrimaryButtonText="Execute"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary"
                       PrimaryButtonClick="CommandPalette_ExecuteClick">
            <StackPanel Spacing="12" Width="440">
                <AutoSuggestBox x:Name="CommandSuggestBox"
                                PlaceholderText="Type a command or action (e.g. Ingest, Switch, Model)..."
                                QueryIcon="Find"
                                TextChanged="CommandSuggestBox_TextChanged"
                                SuggestionChosen="CommandSuggestBox_SuggestionChosen" />
                <ListView x:Name="CommandListView"
                          Height="180"
                          SelectionMode="Single"
                          ItemClick="CommandListView_ItemClick"
                          IsItemClickEnabled="True">
                    <ListView.Items>
                        <ListViewItem Content="📄 Ingest Scientific PDF Textbook..." Tag="ingest" />
                        <ListViewItem Content="🧠 Switch Model: Qwen 2.5 Coder 3B" Tag="qwen2.5-coder:3b" />
                        <ListViewItem Content="🩺 Switch Model: MedGemma 4B (Clinical)" Tag="medgemma:4b" />
                        <ListViewItem Content="⚡ Start Local Ollama AI Engine" Tag="start_ollama" />
                        <ListViewItem Content="🔄 Refresh System Status &amp; VRAM" Tag="refresh_status" />
                        <ListViewItem Content="🔒 Toggle Zero-Trust Airgap Policy" Tag="toggle_airgap" />
                    </ListView.Items>
                </ListView>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
