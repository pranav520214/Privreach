<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PrivreachDesktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PrivreachDesktop"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============================================== -->
            <!-- PRIVREACH PREMIUM LIGHT SKEUOMORPHIC PALETTE   -->
            <!-- ============================================== -->
            <!-- Canvas & Surface Brushes -->
            <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#F6F8FA" />
            <SolidColorBrush x:Key="SurfaceWhiteBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceSoftGreyBrush" Color="#F1F5F9" />
            <SolidColorBrush x:Key="SurfaceSubtleGreyBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="BorderLightBrush" Color="#CBD5E1" />

            <!-- Typography Brushes -->
            <SolidColorBrush x:Key="TextNavyPrimaryBrush" Color="#0F172A" />
            <SolidColorBrush x:Key="TextSlateSecondaryBrush" Color="#475569" />
            <SolidColorBrush x:Key="TextMutedTertiaryBrush" Color="#94A3B8" />

            <!-- Accent Brushes -->
            <SolidColorBrush x:Key="AccentBluePrimaryBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="AccentBlueHoverBrush" Color="#1D4ED8" />
            <SolidColorBrush x:Key="AccentBluePillFillBrush" Color="#EFF6FF" />
            <SolidColorBrush x:Key="AccentBluePillStrokeBrush" Color="#BFDBFE" />

            <!-- Status Brushes -->
            <SolidColorBrush x:Key="StatusGreenBrush" Color="#10B981" />
            <SolidColorBrush x:Key="StatusGreenFillBrush" Color="#ECFDF5" />
            <SolidColorBrush x:Key="StatusGreenStrokeBrush" Color="#A7F3D0" />
            <SolidColorBrush x:Key="StatusAmberBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="StatusAmberFillBrush" Color="#FFFBEB" />
            <SolidColorBrush x:Key="StatusRedBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="StatusRedFillBrush" Color="#FEF2F2" />

            <!-- Corner Radii -->
            <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
            <CornerRadius x:Key="PanelCornerRadius">14</CornerRadius>
            <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="PillCornerRadius">16</CornerRadius>

            <!-- Reusable Skeuomorphic Card Style -->
            <Style x:Key="SkeuoCardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#E2E8F0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
            </Style>

            <!-- Reusable Secondary Card Style -->
            <Style x:Key="SecondaryCardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="#F8FAFC" />
                <Setter Property="BorderBrush" Value="#E2E8F0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
            </Style>

            <!-- Active Pill Button Style -->
            <Style x:Key="PillTabButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#EFF6FF" />
                <Setter Property="Foreground" Value="#2563EB" />
                <Setter Property="BorderBrush" Value="#BFDBFE" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- Inactive Pill Button Style -->
            <Style x:Key="InactivePillTabButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#64748B" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- Nav Icon Button Style -->
            <Style x:Key="NavIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="42" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
