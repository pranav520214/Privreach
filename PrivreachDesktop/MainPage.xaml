<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrivreachDesktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PrivreachDesktop"
    xmlns:models="using:PrivreachDesktop.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource CanvasBackgroundBrush}"
          AllowDrop="True"
          DragOver="RootGrid_DragOver"
          Drop="RootGrid_Drop">
        
        <Grid.ColumnDefinitions>
            <!-- PANEL 1: Left Navigation & Research Domain Console (280px) -->
            <ColumnDefinition Width="280" MinWidth="230" MaxWidth="350" />
            <!-- PANEL 2: Center Scientific Workspace (*) -->
            <ColumnDefinition Width="*" MinWidth="620" />
            <!-- PANEL 3: Right Contextual Chat & System Tools (380px) -->
            <ColumnDefinition Width="380" MinWidth="320" MaxWidth="460" />
        </Grid.ColumnDefinitions>

        <!-- ======================================================== -->
        <!-- PANEL 1: LEFT NAVIGATION & RESEARCH DOMAIN CONSOLE       -->
        <!-- ======================================================== -->
        <Border Grid.Column="0"
                Background="{StaticResource CanvasBackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Slim Icon Bar (52px) -->
                    <ColumnDefinition Width="52" />
                    <!-- Research Hierarchy Tree Column (*) -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- SLIM ICON BAR -->
                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceWhiteBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="0,12,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top Navigation Icons -->
                        <StackPanel Grid.Row="0" Spacing="6" HorizontalAlignment="Center">
                            <Button Style="{StaticResource NavIconButtonStyle}"
                                    Background="{x:Bind local:MainPage.NavSectionToActiveBrush(ViewModel.SelectedNavSection, 'Home'), Mode=OneWay}"
                                    Tag="Home" Click="NavIconButton_Click"
                                    ToolTipService.ToolTip="Home Dashboard">
                                <FontIcon Glyph="&#xE80F;" FontSize="16" Foreground="{x:Bind local:MainPage.NavSectionToForegroundBrush(ViewModel.SelectedNavSection, 'Home'), Mode=OneWay}" />
                            </Button>
                            
                            <!-- Research Workstation -->
                            <Button Style="{StaticResource NavIconButtonStyle}"
                                    Background="{x:Bind local:MainPage.NavSectionToActiveBrush(ViewModel.SelectedNavSection, 'Research'), Mode=OneWay}"
                                    Tag="Research" Click="NavIconButton_Click"
                                    ToolTipService.ToolTip="Scientific Research Workstation">
                                <FontIcon Glyph="&#xE95A;" FontSize="16" Foreground="{x:Bind local:MainPage.NavSectionToForegroundBrush(ViewModel.SelectedNavSection, 'Research'), Mode=OneWay}" />
                            </Button>

                            <Button Style="{StaticResource NavIconButtonStyle}"
                                    Background="{x:Bind local:MainPage.NavSectionToActiveBrush(ViewModel.SelectedNavSection, 'Projects'), Mode=OneWay}"
                                    Tag="Projects" Click="NavIconButton_Click"
                                    ToolTipService.ToolTip="Projects &amp; Experiments">
                                <FontIcon Glyph="&#xE8F1;" FontSize="16" Foreground="{x:Bind local:MainPage.NavSectionToForegroundBrush(ViewModel.SelectedNavSection, 'Projects'), Mode=OneWay}" />
                            </Button>

                            <Button Style="{StaticResource NavIconButtonStyle}"
                                    Background="{x:Bind local:MainPage.NavSectionToActiveBrush(ViewModel.SelectedNavSection, 'Knowledge'), Mode=OneWay}"
                                    Tag="Knowledge" Click="NavIconButton_Click"
                                    ToolTipService.ToolTip="Knowledge Graph &amp; Vault">
                                <FontIcon Glyph="&#xE81D;" FontSize="16" Foreground="{x:Bind local:MainPage.NavSectionToForegroundBrush(ViewModel.SelectedNavSection, 'Knowledge'), Mode=OneWay}" />
                            </Button>

                            <Button Style="{StaticResource NavIconButtonStyle}"
                                    Background="{x:Bind local:MainPage.NavSectionToActiveBrush(ViewModel.SelectedNavSection, 'Environments'), Mode=OneWay}"
                                    Tag="Environments" Click="NavIconButton_Click"
                                    ToolTipService.ToolTip="Scientific Computing &amp; SymPy Solver">
                                <FontIcon Glyph="&#xE9CA;" FontSize="16" Foreground="{x:Bind local:MainPage.NavSectionToForegroundBrush(ViewModel.SelectedNavSection, 'Environments'), Mode=OneWay}" />
                            </Button>

                            <Button Style="{StaticResource NavIconButtonStyle}"
                                    Background="{x:Bind local:MainPage.NavSectionToActiveBrush(ViewModel.SelectedNavSection, 'Artifacts'), Mode=OneWay}"
                                    Tag="Artifacts" Click="NavIconButton_Click"
                                    ToolTipService.ToolTip="Generated Research Artifacts &amp; Provenance">
                                <FontIcon Glyph="&#xE8F4;" FontSize="16" Foreground="{x:Bind local:MainPage.NavSectionToForegroundBrush(ViewModel.SelectedNavSection, 'Artifacts'), Mode=OneWay}" />
                            </Button>
                        </StackPanel>

                        <!-- Bottom Settings Icon -->
                        <Button Grid.Row="1"
                                Style="{StaticResource NavIconButtonStyle}"
                                Background="{x:Bind local:MainPage.NavSectionToActiveBrush(ViewModel.SelectedNavSection, 'Settings'), Mode=OneWay}"
                                Tag="Settings" Click="NavIconButton_Click"
                                HorizontalAlignment="Center"
                                ToolTipService.ToolTip="Workstation Preferences &amp; OTA Updates">
                            <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{x:Bind local:MainPage.NavSectionToForegroundBrush(ViewModel.SelectedNavSection, 'Settings'), Mode=OneWay}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- RESEARCH HIERARCHY TREE & TOOLS COLUMN -->
                <Grid Grid.Column="1" Padding="14,14,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Research"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextNavyPrimaryBrush}" />
                            <TextBlock Text="▾" FontSize="12" Foreground="{StaticResource TextSlateSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Select computational domain"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedTertiaryBrush}" />
                    </StackPanel>

                    <!-- Scrollable Domains & Tools List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <!-- Research Domains Section -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="RESEARCH DOMAINS"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedTertiaryBrush}"
                                           Margin="4,0,0,4" />

                                <!-- Aerospace Domain Pill -->
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,7"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        Background="{x:Bind local:MainPage.DomainToActiveBrush(ViewModel.SelectedResearchDomain, 'Aerospace'), Mode=OneWay}"
                                        BorderBrush="{x:Bind local:MainPage.DomainToBorderBrush(ViewModel.SelectedResearchDomain, 'Aerospace'), Mode=OneWay}"
                                        Foreground="{x:Bind local:MainPage.DomainToForegroundBrush(ViewModel.SelectedResearchDomain, 'Aerospace'), Mode=OneWay}"
                                        Tag="Aerospace" Click="DomainButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="✈️" FontSize="12" />
                                        <TextBlock Text="Aerospace" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <!-- Physics Domain Pill -->
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,7"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        Background="{x:Bind local:MainPage.DomainToActiveBrush(ViewModel.SelectedResearchDomain, 'Physics'), Mode=OneWay}"
                                        BorderBrush="{x:Bind local:MainPage.DomainToBorderBrush(ViewModel.SelectedResearchDomain, 'Physics'), Mode=OneWay}"
                                        Foreground="{x:Bind local:MainPage.DomainToForegroundBrush(ViewModel.SelectedResearchDomain, 'Physics'), Mode=OneWay}"
                                        Tag="Physics" Click="DomainButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="⚛️" FontSize="12" />
                                        <TextBlock Text="Physics" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <!-- Biology Domain Pill -->
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,7"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        Background="{x:Bind local:MainPage.DomainToActiveBrush(ViewModel.SelectedResearchDomain, 'Biology'), Mode=OneWay}"
                                        BorderBrush="{x:Bind local:MainPage.DomainToBorderBrush(ViewModel.SelectedResearchDomain, 'Biology'), Mode=OneWay}"
                                        Foreground="{x:Bind local:MainPage.DomainToForegroundBrush(ViewModel.SelectedResearchDomain, 'Biology'), Mode=OneWay}"
                                        Tag="Biology" Click="DomainButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="🧬" FontSize="12" />
                                        <TextBlock Text="Biology" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <!-- Chemistry Domain Pill -->
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,7"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        Background="{x:Bind local:MainPage.DomainToActiveBrush(ViewModel.SelectedResearchDomain, 'Chemistry'), Mode=OneWay}"
                                        BorderBrush="{x:Bind local:MainPage.DomainToBorderBrush(ViewModel.SelectedResearchDomain, 'Chemistry'), Mode=OneWay}"
                                        Foreground="{x:Bind local:MainPage.DomainToForegroundBrush(ViewModel.SelectedResearchDomain, 'Chemistry'), Mode=OneWay}"
                                        Tag="Chemistry" Click="DomainButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="🧪" FontSize="12" />
                                        <TextBlock Text="Chemistry" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <!-- Robotics Domain Pill -->
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,7"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        Background="{x:Bind local:MainPage.DomainToActiveBrush(ViewModel.SelectedResearchDomain, 'Robotics'), Mode=OneWay}"
                                        BorderBrush="{x:Bind local:MainPage.DomainToBorderBrush(ViewModel.SelectedResearchDomain, 'Robotics'), Mode=OneWay}"
                                        Foreground="{x:Bind local:MainPage.DomainToForegroundBrush(ViewModel.SelectedResearchDomain, 'Robotics'), Mode=OneWay}"
                                        Tag="Robotics" Click="DomainButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="🤖" FontSize="12" />
                                        <TextBlock Text="Robotics" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <!-- Computer Science Domain Pill -->
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,7"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        Background="{x:Bind local:MainPage.DomainToActiveBrush(ViewModel.SelectedResearchDomain, 'Computer Science'), Mode=OneWay}"
                                        BorderBrush="{x:Bind local:MainPage.DomainToBorderBrush(ViewModel.SelectedResearchDomain, 'Computer Science'), Mode=OneWay}"
                                        Foreground="{x:Bind local:MainPage.DomainToForegroundBrush(ViewModel.SelectedResearchDomain, 'Computer Science'), Mode=OneWay}"
                                        Tag="Computer Science" Click="DomainButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="💻" FontSize="12" />
                                        <TextBlock Text="Computer Science" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <!-- Materials Science Domain Pill -->
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,7"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        Background="{x:Bind local:MainPage.DomainToActiveBrush(ViewModel.SelectedResearchDomain, 'Materials Science'), Mode=OneWay}"
                                        BorderBrush="{x:Bind local:MainPage.DomainToBorderBrush(ViewModel.SelectedResearchDomain, 'Materials Science'), Mode=OneWay}"
                                        Foreground="{x:Bind local:MainPage.DomainToForegroundBrush(ViewModel.SelectedResearchDomain, 'Materials Science'), Mode=OneWay}"
                                        Tag="Materials Science" Click="DomainButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="🧱" FontSize="12" />
                                        <TextBlock Text="Materials Science" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <!-- Mathematics Domain Pill -->
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,7"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        Background="{x:Bind local:MainPage.DomainToActiveBrush(ViewModel.SelectedResearchDomain, 'Mathematics'), Mode=OneWay}"
                                        BorderBrush="{x:Bind local:MainPage.DomainToBorderBrush(ViewModel.SelectedResearchDomain, 'Mathematics'), Mode=OneWay}"
                                        Foreground="{x:Bind local:MainPage.DomainToForegroundBrush(ViewModel.SelectedResearchDomain, 'Mathematics'), Mode=OneWay}"
                                        Tag="Mathematics" Click="DomainButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="📐" FontSize="12" />
                                        <TextBlock Text="Mathematics" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Tools & Resources Section -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="TOOLS &amp; RESOURCES"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedTertiaryBrush}"
                                           Margin="4,0,0,4" />

                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,7"
                                        CornerRadius="8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="IngestButton_Click"
                                        ToolTipService.ToolTip="Ingest PDF document into zero-trust vault">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                        <TextBlock Text="PDF Ingester" FontSize="12" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                    </StackPanel>
                                </Button>

                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,7"
                                        CornerRadius="8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="IngestButton_Click"
                                        ToolTipService.ToolTip="Extract frames and ingest video into local vault">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE714;" FontSize="13" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                        <TextBlock Text="Video Ingester" FontSize="12" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                    </StackPanel>
                                </Button>

                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,7"
                                        CornerRadius="8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Tag="Matrix View" Click="TabButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9D2;" FontSize="13" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                        <TextBlock Text="Data Analysis" FontSize="12" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                    </StackPanel>
                                </Button>

                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,7"
                                        CornerRadius="8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Tag="3D Model" Click="TabButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9CE;" FontSize="13" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                        <TextBlock Text="3D Models" FontSize="12" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                    </StackPanel>
                                </Button>

                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,7"
                                        CornerRadius="8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Tag="Simulation" Click="TabButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                        <TextBlock Text="Simulations" FontSize="12" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Privacy & Security Status Card -->
                    <Border Grid.Row="2"
                            Background="{StaticResource SurfaceWhiteBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8"
                                     Fill="{StaticResource StatusGreenBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Local processing"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                <TextBlock Text="All systems secure • Air-Gapped"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSlateSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- PANEL 2: CENTER SCIENTIFIC WORKSPACE                     -->
        <!-- ======================================================== -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="20,16,20,16"
                      Visibility="{x:Bind local:MainPage.NavSectionToVisibility(ViewModel.SelectedNavSection, 'Research'), Mode=OneWay}">
            <StackPanel Spacing="16">

                <!-- CARD 1: SCIENTIFIC ANALYSIS & KEY RESULTS -->
                <Border Style="{StaticResource SkeuoCardBorderStyle}"
                        Padding="18">
                    <StackPanel Spacing="14">
                        <!-- Card Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.ActiveProjectTitle, Mode=OneWay}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.GoverningEquation, Mode=OneWay}"
                                           FontSize="11"
                                           FontFamily="Consolas, Cascadia Code"
                                           Foreground="{StaticResource AccentBluePrimaryBrush}" />
                            </StackPanel>

                            <!-- Airflow/Status Badge -->
                            <Border Grid.Column="1"
                                    Background="{StaticResource AccentBluePillFillBrush}"
                                    BorderBrush="{StaticResource AccentBluePillStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,3"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="11" Foreground="{StaticResource AccentBluePrimaryBrush}" />
                                    <TextBlock Text="Subsonic CFD Stream" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBluePrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Key Results Grid (4-cell scientific metric layout) -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Metric 1: Lift-to-Drag Ratio -->
                            <Border Grid.Column="0"
                                    Background="{StaticResource SurfaceSubtleGreyBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Lift-to-Drag Ratio" FontSize="10" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.LiftToDragRatio, Mode=OneWay}"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 2: Drag Coefficient -->
                            <Border Grid.Column="1"
                                    Background="{StaticResource SurfaceSubtleGreyBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Drag Coefficient" FontSize="10" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.DragCoefficient, Mode=OneWay}"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 3: Lift Coefficient -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource SurfaceSubtleGreyBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Lift Coefficient" FontSize="10" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.LiftCoefficient, Mode=OneWay}"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBluePrimaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 4: Stall Angle -->
                            <Border Grid.Column="3"
                                    Background="{StaticResource SurfaceSubtleGreyBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Stall Angle" FontSize="10" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.StallAngle, Mode=OneWay}"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource StatusGreenBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- WORKSPACE MODE SWITCHER (Segmented Pill Tab Bar) -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- Tab: 3D Model -->
                    <Button Padding="14,6" CornerRadius="16" BorderThickness="1" FontSize="12"
                            Background="{x:Bind local:MainPage.TabToActiveBrush(ViewModel.ActiveCenterTab, '3D Model'), Mode=OneWay}"
                            BorderBrush="{x:Bind local:MainPage.TabToBorderBrush(ViewModel.ActiveCenterTab, '3D Model'), Mode=OneWay}"
                            Foreground="{x:Bind local:MainPage.TabToForegroundBrush(ViewModel.ActiveCenterTab, '3D Model'), Mode=OneWay}"
                            Tag="3D Model" Click="TabButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9CE;" FontSize="12" />
                            <TextBlock Text="3D Model" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Tab: Simulation -->
                    <Button Padding="14,6" CornerRadius="16" BorderThickness="1" FontSize="12"
                            Background="{x:Bind local:MainPage.TabToActiveBrush(ViewModel.ActiveCenterTab, 'Simulation'), Mode=OneWay}"
                            BorderBrush="{x:Bind local:MainPage.TabToBorderBrush(ViewModel.ActiveCenterTab, 'Simulation'), Mode=OneWay}"
                            Foreground="{x:Bind local:MainPage.TabToForegroundBrush(ViewModel.ActiveCenterTab, 'Simulation'), Mode=OneWay}"
                            Tag="Simulation" Click="TabButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                            <TextBlock Text="Simulation" />
                        </StackPanel>
                    </Button>

                    <!-- Tab: Graphs -->
                    <Button Padding="14,6" CornerRadius="16" BorderThickness="1" FontSize="12"
                            Background="{x:Bind local:MainPage.TabToActiveBrush(ViewModel.ActiveCenterTab, 'Graphs'), Mode=OneWay}"
                            BorderBrush="{x:Bind local:MainPage.TabToBorderBrush(ViewModel.ActiveCenterTab, 'Graphs'), Mode=OneWay}"
                            Foreground="{x:Bind local:MainPage.TabToForegroundBrush(ViewModel.ActiveCenterTab, 'Graphs'), Mode=OneWay}"
                            Tag="Graphs" Click="TabButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE81D;" FontSize="12" />
                            <TextBlock Text="Graphs" />
                        </StackPanel>
                    </Button>

                    <!-- Tab: Matrix View -->
                    <Button Padding="14,6" CornerRadius="16" BorderThickness="1" FontSize="12"
                            Background="{x:Bind local:MainPage.TabToActiveBrush(ViewModel.ActiveCenterTab, 'Matrix View'), Mode=OneWay}"
                            BorderBrush="{x:Bind local:MainPage.TabToBorderBrush(ViewModel.ActiveCenterTab, 'Matrix View'), Mode=OneWay}"
                            Foreground="{x:Bind local:MainPage.TabToForegroundBrush(ViewModel.ActiveCenterTab, 'Matrix View'), Mode=OneWay}"
                            Tag="Matrix View" Click="TabButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9D2;" FontSize="12" />
                            <TextBlock Text="Matrix View" />
                        </StackPanel>
                    </Button>

                    <!-- Tab: Results -->
                    <Button Padding="14,6" CornerRadius="16" BorderThickness="1" FontSize="12"
                            Background="{x:Bind local:MainPage.TabToActiveBrush(ViewModel.ActiveCenterTab, 'Results'), Mode=OneWay}"
                            BorderBrush="{x:Bind local:MainPage.TabToBorderBrush(ViewModel.ActiveCenterTab, 'Results'), Mode=OneWay}"
                            Foreground="{x:Bind local:MainPage.TabToForegroundBrush(ViewModel.ActiveCenterTab, 'Results'), Mode=OneWay}"
                            Tag="Results" Click="TabButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE73E;" FontSize="12" />
                            <TextBlock Text="Results" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- CARD 2A: MATRIX VIEW (Interactive 100x100 Computational Matrix) -->
                <Border Style="{StaticResource SkeuoCardBorderStyle}"
