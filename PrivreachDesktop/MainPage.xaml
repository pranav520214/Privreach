                                            <!-- Reynolds Number -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Reynolds Number:" FontSize="11" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.ReynoldsNumber, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextNavyPrimaryBrush}" />

                                            <!-- Boundary Layer -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Boundary Layer:" FontSize="11" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.BoundaryLayer, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextNavyPrimaryBrush}" />

                                            <!-- Vorticity -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Vorticity:" FontSize="11" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.Vorticity, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBluePrimaryBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 3D Wing Wireframe Preview Box -->
                                <Border Background="{StaticResource SurfaceSubtleGreyBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="3D WING WIREFRAME"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                        
                                        <!-- Stylized NACA Chord Wireframe Mockup -->
                                        <Border Height="80"
                                                Background="#FFFFFF"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10">
                                            <Grid VerticalAlignment="Center">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="NACA 64-416 Airfoil Section Profile"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentBluePrimaryBrush}" />
                                                    <TextBlock Text="Chord: 1.80m • Span: 12.4m • Aspect Ratio: 8.5 • Sweep: 18°"
                                                               FontSize="9"
                                                               Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                                    <ProgressBar Value="94" Maximum="100" Height="4" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Progress Status Indicator -->
                                <Border Background="{StaticResource SurfaceSubtleGreyBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.MatrixProgressText, Mode=OneWay}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSlateSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <Ellipse Grid.Column="1" Width="8" Height="8"
                                                 Fill="{StaticResource StatusGreenBrush}"
                                                 VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 2B: 3D MODEL VIEW -->
                <Border Style="{StaticResource SkeuoCardBorderStyle}"
                        Padding="18"
                        Visibility="{x:Bind local:MainPage.TabToVisibility(ViewModel.ActiveCenterTab, '3D Model'), Mode=OneWay}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="3D Aerodynamic Model &amp; Surface Mesh"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                <TextBlock Text="Parametric geometry, camber line, and chord discretization"
                                           FontSize="11" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource AccentBluePillFillBrush}"
                                    BorderBrush="{StaticResource AccentBluePillStrokeBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="Mesh: 14,280 Elements" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBluePrimaryBrush}" />
                            </Border>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 3D Airfoil Profile Visualizer -->
                            <Border Grid.Column="0" Height="280" Background="#FFFFFF"
                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                                        <TextBlock Text="✈️" FontSize="48" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.ActiveProjectTitle, Mode=OneWay}"
                                                   FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextNavyPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Supercritical Wing Design • Sweep 18° • Aspect Ratio 8.5 • Dihedral 2.5°"
                                                   FontSize="11" Foreground="{StaticResource TextSlateSecondaryBrush}" HorizontalAlignment="Center" />
                                        <Border Background="{StaticResource SurfaceSubtleGreyBrush}" CornerRadius="6" Padding="10,6">
                                            <TextBlock Text="{x:Bind ViewModel.GoverningEquation, Mode=OneWay}"
                                                       FontSize="11" FontFamily="Consolas, Cascadia Code" Foreground="{StaticResource AccentBluePrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Geometry Specifications Table -->
                            <Border Grid.Column="1" Background="{StaticResource SurfaceSubtleGreyBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="GEOMETRIC PARAMETERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                    <Grid RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Wingspan (b):" FontSize="11" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="12.4 m" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextNavyPrimaryBrush}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Root Chord (c_r):" FontSize="11" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="2.10 m" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextNavyPrimaryBrush}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tip Chord (c_t):" FontSize="11" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="0.85 m" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextNavyPrimaryBrush}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Planform Area (S):" FontSize="11" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="18.29 m²" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextNavyPrimaryBrush}" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Taper Ratio (λ):" FontSize="11" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="0.405" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 2C: SIMULATION & DETERMINISTIC SYMPY SOLVER -->
                <Border Style="{StaticResource SkeuoCardBorderStyle}"
                        Padding="18"
                        Visibility="{x:Bind local:MainPage.TabToVisibility(ViewModel.ActiveCenterTab, 'Simulation'), Mode=OneWay}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Interactive SymPy Equation Solver &amp; Simulation"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                <TextBlock Text="Deterministic symbolic AST algebra without LLM calculation error"
                                           FontSize="11" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource StatusGreenFillBrush}"
                                    BorderBrush="{StaticResource StatusGreenStrokeBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="Zero-Hallucination Active" FontSize="11" FontWeight="Bold" Foreground="{StaticResource StatusGreenBrush}" />
                            </Border>
                        </Grid>

                        <!-- Solver Controls -->
                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Governing Equation:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                <TextBox Text="{x:Bind ViewModel.SolveEquationText, Mode=TwoWay}"
                                         PlaceholderText="e.g. P * V = n * R * T"
                                         FontSize="12" FontFamily="Consolas, Cascadia Code" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Solve For:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                <TextBox Text="{x:Bind ViewModel.SolveTargetVariable, Mode=TwoWay}"
                                         PlaceholderText="e.g. P"
                                         FontSize="12" FontFamily="Consolas, Cascadia Code" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Known Variables:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                <TextBox Text="{x:Bind ViewModel.SolveVariablesText, Mode=TwoWay}"
                                         PlaceholderText="V=0.05, n=2.0, T=350.0"
                                         FontSize="12" FontFamily="Consolas, Cascadia Code" />
                            </StackPanel>

                            <Button Grid.Column="3"
                                    VerticalAlignment="Bottom"
                                    Height="32" Padding="14,0"
                                    Background="{StaticResource AccentBluePrimaryBrush}"
                                    Foreground="#FFFFFF" CornerRadius="6"
                                    Command="{x:Bind ViewModel.SolveInteractiveEquationCommand}"
                                    IsEnabled="{x:Bind local:MainPage.Not(ViewModel.IsSolving), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE946;" FontSize="12" />
                                    <TextBlock Text="Solve" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Solver Result Panel -->
                        <Border Background="{StaticResource SurfaceSubtleGreyBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock Text="COMPUTED SOLUTION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedTertiaryBrush}" />
                                    <ProgressRing Width="14" Height="14" HorizontalAlignment="Right" IsActive="{x:Bind ViewModel.IsSolving, Mode=OneWay}" />
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.SolveResultText, Mode=OneWay}"
                                           FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBluePrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SolveFormulaLatex, Mode=OneWay}"
                                           FontSize="12" FontFamily="Consolas, Cascadia Code" Foreground="{StaticResource TextNavyPrimaryBrush}"
                                           Visibility="{x:Bind local:MainPage.StringNotEmptyToVisibility(ViewModel.SolveFormulaLatex), Mode=OneWay}" />
                                <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10"
                                        Visibility="{x:Bind local:MainPage.StringNotEmptyToVisibility(ViewModel.SolveCodeExecuted), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.SolveCodeExecuted, Mode=OneWay}"
                                               FontSize="11" FontFamily="Consolas, Cascadia Code" Foreground="{StaticResource TextSlateSecondaryBrush}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- CARD 2D: GRAPHS & KNOWLEDGE GRAPH VIEW -->
                <Border Style="{StaticResource SkeuoCardBorderStyle}"
                        Padding="18"
                        Visibility="{x:Bind local:MainPage.TabToVisibility(ViewModel.ActiveCenterTab, 'Graphs'), Mode=OneWay}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="GraphRAG Cross-Document Citation Topology"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                <TextBlock Text="Discovered cross-document bridges, shared entities, and citation paths"
                                           FontSize="11" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource AccentBluePillFillBrush}"
                                    BorderBrush="{StaticResource AccentBluePillStrokeBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="Deterministic Bridges" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBluePrimaryBrush}" />
                            </Border>
                        </Grid>

                        <!-- Retrieved Passages & Bridges List -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RetrievedChunks, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:RetrievedChunkDto">
                                    <Border Background="{StaticResource SurfaceSubtleGreyBrush}"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                            Tapped="ChunkItem_Tapped">
                                        <StackPanel Spacing="4">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="📄" FontSize="11" />
                                                    <TextBlock Text="{x:Bind DocName}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                                    <TextBlock Text="• Page" FontSize="11" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind PageNum}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                                </StackPanel>
                                                <Border HorizontalAlignment="Right" Background="{StaticResource AccentBluePillFillBrush}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{x:Bind SectionHeader}" FontSize="10" Foreground="{StaticResource AccentBluePrimaryBrush}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{x:Bind Text}" FontSize="11" Foreground="{StaticResource TextSlateSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- CARD 2E: RESULTS VIEW (Academic Synthesis, Claims Verification & Synchronized PDF) -->
                <Border Style="{StaticResource SkeuoCardBorderStyle}"
                        Padding="18"
                        Visibility="{x:Bind local:MainPage.TabToVisibility(ViewModel.ActiveCenterTab, 'Results'), Mode=OneWay}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="PEER-REVIEWED ACADEMIC SYNTHESIS"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                <TextBlock Text="Deterministic SymPy verification &amp; hybrid multi-modal evidence"
                                           FontSize="11" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{StaticResource StatusGreenFillBrush}"
                                    BorderBrush="{StaticResource StatusGreenStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,4">
                                <TextBlock Text="{x:Bind ViewModel.GroundingScoreText, Mode=OneWay}"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource StatusGreenBrush}" />
                            </Border>
                        </Grid>

                        <!-- Synthesis Text -->
                        <Border Background="{StaticResource SurfaceSubtleGreyBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <TextBlock Text="{x:Bind ViewModel.CurrentResult.SynthesisText, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       FontSize="13"
                                       LineHeight="20"
                                       Foreground="{StaticResource TextNavyPrimaryBrush}" />
                        </Border>

                        <!-- Verification Matrix Claims List -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="CLAIM VERIFICATION MATRIX" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Claims, Mode=OneWay}">
