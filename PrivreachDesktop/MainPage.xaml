                                                BorderThickness="0" Tag="Heatmap" Click="ViewModeButton_Click" />
                                        <Button Content="Vector Flow" Padding="8,4" FontSize="11" CornerRadius="6"
                                                Background="{x:Bind local:MainPage.TabToActiveBrush(ViewModel.MatrixViewMode, 'Vector Flow'), Mode=OneWay}"
                                                Foreground="{x:Bind local:MainPage.TabToForegroundBrush(ViewModel.MatrixViewMode, 'Vector Flow'), Mode=OneWay}"
                                                BorderThickness="0" Tag="Vector Flow" Click="ViewModeButton_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Main Matrix Body: Left Live Dot Matrix Canvas + Right Aerodynamic Metrics -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <!-- Dot Matrix Canvas (420px) -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Aerodynamic Metrics &amp; Wireframe (*) -->
