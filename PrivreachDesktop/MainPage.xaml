                                    <DataTemplate x:DataType="models:ClaimDto">
                                        <Border Background="{StaticResource SurfaceSubtleGreyBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6"
                                                Tapped="ClaimItem_Tapped">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{x:Bind Text}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextNavyPrimaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind CitationReference}" FontSize="10" Foreground="{StaticResource AccentBluePrimaryBrush}" />
                                                </StackPanel>
                                                <Border Grid.Column="1" VerticalAlignment="Center" Background="{StaticResource StatusGreenFillBrush}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{x:Bind StatusBadge}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource StatusGreenBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- PDF Viewer Synchronization View -->
                        <Border Background="{StaticResource SurfaceWhiteBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
