<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrivreachDesktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PrivreachDesktop"
    xmlns:models="using:PrivreachDesktop.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          AllowDrop="True"
          DragOver="RootGrid_DragOver"
          Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <!-- Top Command & Status Ribbon -->
            <RowDefinition Height="Auto" />
            <!-- System Update & Alert InfoBar -->
            <RowDefinition Height="Auto" />
            <!-- Three-Plane Workstation Body -->
            <RowDefinition Height="*" />
            <!-- Bottom Hardware & System Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP WORKSTATION RIBBON -->
        <Border Grid.Row="0"
                Padding="16,10"
                BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE95A;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="PRIVREACH OS" FontWeight="Bold" VerticalAlignment="Center" FontSize="14" />
                    <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="v2.0 Native Fluent" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="SemiBold" />
                    </Border>
                    <Border Background="#1a2234" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="🔒 100% Local Air-Gap" FontSize="11" Foreground="#38bdf8" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <!-- Center Active Status Summary -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8"
                                 Fill="{x:Bind local:MainPage.EngineRunningToBrush(ViewModel.SystemStatus.EngineRunning), Mode=OneWay}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.EngineStatusText, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="|" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.MemoryStatusText, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="|" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.VaultStatusText, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right Quick Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Click="IngestButton_Click" ToolTipService.ToolTip="Ingest PDF Textbook or Media">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE898;" FontSize="14" />
                            <TextBlock Text="Ingest PDF" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ClearVaultCommand}" ToolTipService.ToolTip="Clear Knowledge Vault &amp; Reset Index">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#f87171" />
                            <TextBlock Text="Clear Vault" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.CheckForUpdatesCommand}" ToolTipService.ToolTip="Check for Updates &amp; System Patches">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE895;" FontSize="14" />
                            <TextBlock Text="Updates" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.RefreshStatusCommand}" ToolTipService.ToolTip="Refresh Status">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- NOTIFICATION INFOBAR -->
        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.HasUpdaterNotification, Mode=TwoWay}"
                 Severity="Informational"
                 Title="Privreach OS Update"
                 Message="{x:Bind ViewModel.UpdaterNotificationText, Mode=OneWay}"
                 IsClosable="True"
                 Margin="16,6,16,6" />

        <!-- THREE-PLANE WORKSTATION BODY -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- PLANE 1: Left - Inquiry, Router & AI Dock (360px) -->
                <ColumnDefinition Width="360" MinWidth="300" MaxWidth="440" />
                <!-- PLANE 2: Center - Academic Synthesis & Explainer Canvas (*) -->
                <ColumnDefinition Width="*" MinWidth="480" />
                <!-- PLANE 3: Right - Claim Matrix & Synchronized PDF Viewer (460px) -->
                <ColumnDefinition Width="460" MinWidth="380" MaxWidth="600" />
            </Grid.ColumnDefinitions>

            <!-- ========================================== -->
            <!-- PLANE 1: LEFT - INQUIRY & NAVIGATION CONSOLE -->
            <!-- ========================================== -->
            <Border Grid.Column="0"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,14,14,20">
                    <StackPanel Spacing="16">
                        <!-- Section: Research Inquiry Input -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="RESEARCH INQUIRY" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="Bold" />
                                </StackPanel>

                                <TextBox Text="{x:Bind ViewModel.QueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="90"
                                         PlaceholderText="Ask a scientific question (e.g. ideal gas pressure at high temperature, tacrolimus clearance, organic reaction mechanism)..." />

                                <!-- Sample Query Chips -->
                                <TextBlock Text="Quick STEM Prompts:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Ideal Gas P"
                                            FontSize="11"
                                            Padding="8,4"
                                            Tag="Calculate the pressure of 2 moles of ideal gas occupying 0.05 m³ at 350 Kelvin using P = nRT / V."
                                            Click="SampleChip_Click" />
                                    <Button Content="Tacrolimus PK"
                                            FontSize="11"
                                            Padding="8,4"
                                            Tag="What is the clearance and bioavailability equation for tacrolimus in renal transplant recipients?"
                                            Click="SampleChip_Click" />
                                    <Button Content="Gibbs Energy"
                                            FontSize="11"
                                            Padding="8,4"
                                            Tag="Derive Gibbs Free Energy ΔG = ΔH - TΔS and determine spontaneity criteria."
                                            Click="SampleChip_Click" />
                                </StackPanel>

                                <!-- Execute Button -->
                                <Button Command="{x:Bind ViewModel.ExecuteQueryCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{x:Bind local:MainPage.Not(ViewModel.IsBusy), Mode=OneWay}"
                                        Padding="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                                      Width="16" Height="16"
                                                      Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsBusy), Mode=OneWay}" />
                                        <FontIcon Glyph="&#xE768;" FontSize="14"
                                                  Visibility="{x:Bind local:MainPage.InvertBoolToVisibility(ViewModel.IsBusy), Mode=OneWay}" />
                                        <TextBlock Text="Execute RLCD Inquiry" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Section: 0.5B Router Analysis Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Visibility="{x:Bind local:MainPage.NotNullToVisibility(ViewModel.QueryAnalysis), Mode=OneWay}">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="#38bdf8" />
                                    <TextBlock Text="0.5B ROUTER ANALYSIS" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="Bold" />
                                </StackPanel>

                                <!-- Risk Badge & Task -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Risk Level" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.QueryAnalysis.RiskLevel, Mode=OneWay}" FontWeight="Bold" Foreground="#38bdf8" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Task Type" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.QueryAnalysis.TaskType, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Scientific Domain" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,4,0,0" />
                                <TextBlock Text="{x:Bind ViewModel.QueryAnalysis.ScientificDomain, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" />

                                <TextBlock Text="Analysis Rationale" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,4,0,0" />
                                <TextBlock Text="{x:Bind ViewModel.QueryAnalysis.AnalysisRationale, Mode=OneWay}"
                                           FontSize="11" FontStyle="Italic"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Section: Local AI Engine & Models Dock -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEC05;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="AI ENGINE DOCK" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="Bold" />
                                </StackPanel>

                                <TextBlock Text="Synthesis Engine (3B/4B)" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.AvailableModels, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedSynthesisModel, Mode=TwoWay}"
                                          SelectionChanged="ModelComboBox_SelectionChanged"
                                          PlaceholderText="Select local model" />

                                <TextBlock Text="Dual-Model Brain-Trust Roles:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Router: 0.5B" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Text="CPU In-RAM BM25" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Verifier: 0.5B" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Text="CPU FAISS Vectors" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>

                                <ToggleSwitch Header="Deep Thinking (R1 / CoT)"
                                              IsOn="{x:Bind ViewModel.DeepThinkingEnabled, Mode=TwoWay}"
                                              OnContent="Enabled"
                                              OffContent="Disabled"
                                              FontSize="11"
                                              ToolTipService.ToolTip="Activates multi-step internal chain-of-thought deliberation and self-reflection prior to synthesis." />

                                <Button Command="{x:Bind ViewModel.StartOllamaCommand}"
                                        HorizontalAlignment="Stretch"
                                        FontSize="12"
                                        Padding="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                                        <TextBlock Text="Start Ollama Service" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Section: Document Vault List -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8F1;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="DOCUMENT VAULT" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="Bold" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="IngestButton_Click" Padding="4,2" ToolTipService.ToolTip="Add PDF">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    </Button>
                                </Grid>

                                <ListView ItemsSource="{x:Bind ViewModel.Documents, Mode=OneWay}"
                                          Height="140"
                                          SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:DocumentDto">
                                            <Grid Padding="4,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE8A5;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind DocName}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Chunks}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ======================================================== -->
            <!-- PLANE 2: CENTER - ACADEMIC SYNTHESIS & EXPLAINER CANVAS -->
            <!-- ======================================================== -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,16,24,24">
                <StackPanel Spacing="18" MaxWidth="920">

                    <!-- Workspace Header & Stats -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="PEER-REVIEWED ACADEMIC SYNTHESIS" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                            <TextBlock Text="Dual-Model Grounded Synthesis with Deterministic Verification"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- Grounding Confidence Metric -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,6"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.HasResults), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="#4ade80" />
                                <StackPanel>
                                    <TextBlock Text="Grounding Confidence" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.GroundingScoreText, Mode=OneWay}" FontWeight="Bold" FontSize="13" Foreground="#4ade80" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- CARD 1: Grounded Academic Synthesis Content -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20"
                            Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.HasResults), Mode=OneWay}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="{x:Bind ViewModel.CurrentResult.SynthesisText, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       FontSize="14"
                                       LineHeight="22" />

                            <!-- Interactive Citation Pills Bar -->
                            <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="0,10,0,0">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Interactive Citation References (Click to jump PDF evidence):"
                                               FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Claims, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="8" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:ClaimDto">
                                                <Button Padding="8,4"
                                                        FontSize="11"
                                                        Click="ClaimButton_Click"
                                                        ToolTipService.ToolTip="{x:Bind Text}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="[" />
                                                        <TextBlock Text="{x:Bind ClaimId}" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                        <TextBlock Text="]" />
                                                        <TextBlock Text="{x:Bind CitationReference}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- CARD: Interactive Explainer Canvas - Deep Reasoning & Thought Trace (R1 / CoT) -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20"
                            Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.HasReasoningTrace), Mode=OneWay}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9CE;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="EXPLAINER CANVAS: DEEP REASONING &amp; THOUGHT TRACE (R1 / CoT)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="8,3">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="⏱️ Deliberation:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ThinkingDurationText, Mode=OneWay}" FontSize="11" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Cognitive Deliberation Stages ItemsRepeater -->
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.ReasoningSteps, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:ReasoningStepDto">
                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,8">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <TextBlock Text="{x:Bind Content}" FontSize="11" FontFamily="Consolas, Cascadia Code" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- Full Raw <think> Stream Expander -->
                            <Expander Header="Complete Monospace Thought Stream (&lt;think&gt; ... &lt;/think&gt;)" HorizontalAlignment="Stretch" IsExpanded="False">
                                <TextBox Text="{x:Bind ViewModel.ReasoningTrace, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas, Cascadia Code"
                                         FontSize="11"
                                         AcceptsReturn="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         TextWrapping="Wrap"
                                         MaxHeight="260" />
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- CARD: Interactive Explainer Canvas - Knowledge Graph & Cross-Document Citation Network -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20"
                            Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.HasGraphData), Mode=OneWay}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE81D;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="EXPLAINER CANVAS: KNOWLEDGE GRAPHRAG &amp; CROSS-DOCUMENT CITATIONS" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="8,3">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="🕸️ Topology:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.GraphStatsText, Mode=OneWay}" FontSize="11" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Cross-Document Conceptual Bridges Bar -->
                            <StackPanel Spacing="6" Visibility="{x:Bind local:MainPage.IntToVisibility(ViewModel.CrossDocumentBridgesCount), Mode=OneWay}">
                                <TextBlock Text="🌉 Multi-Document Conceptual Bridges (Shared Entity Connectors):"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.CrossDocBridges, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical" Spacing="6" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:CrossDocBridgeDto">
                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="⚛️" FontSize="13" />
                                                        <TextBlock Text="{x:Bind Entity}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind DocumentsSummary}"
                                                               Margin="16,0,0,0"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{x:Bind RelationsSummary}" FontSize="10" FontFamily="Consolas, Cascadia Code" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>

                            <!-- Graph Topology & Mermaid Flow Expander -->
                            <Expander Header="Complete Network Topology, Mermaid &amp; Community Matrix" HorizontalAlignment="Stretch" IsExpanded="True">
                                <TextBox Text="{x:Bind ViewModel.GraphMarkdown, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas, Cascadia Code"
                                         FontSize="11"
                                         AcceptsReturn="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         TextWrapping="Wrap"
                                         MaxHeight="320" />
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: Interactive Explainer Canvas - Deterministic Computation & Math -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20"
                            Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.HasCalculation), Mode=OneWay}">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9D2;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="EXPLAINER CANVAS: DETERMINISTIC SCIENTIFIC COMPUTE" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>

                            <!-- Governing Equation Banner -->
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="14,10">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Governing Formula / Symbolic Equation:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.CalculationAudit.EquationLatex, Mode=OneWay}"
                                               FontFamily="Consolas, Cascadia Code"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Mathematical Verification Comparison Grid -->
                            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="LLM Synthesis Value:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.CalculationAudit.ModelPredictedValue, Mode=OneWay}"
                                               FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Deterministic SymPy Value:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.CalculationAudit.DeterministicComputedValue, Mode=OneWay}"
                                               FontSize="15" FontWeight="SemiBold" Foreground="#4ade80" />
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Background="#162e21"
                                        BorderBrush="#22c55e"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#4ade80" />
                                        <TextBlock Text="VERIFIED (0.00% Error)" FontSize="11" FontWeight="Bold" Foreground="#4ade80" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Executed Python Code Trace Expander -->
                            <Expander Header="Deterministic Python Sandbox Trace" HorizontalAlignment="Stretch">
                                <TextBox Text="{x:Bind ViewModel.CalculationAudit.CodeExecuted, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas, Cascadia Code"
                                         FontSize="12"
                                         AcceptsReturn="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         TextWrapping="Wrap" />
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: Interactive Explainer Canvas - Vision RAG & Structural Evidence -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20"
                            Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.HasVisualEvidence), Mode=OneWay}">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEB9F;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="EXPLAINER CANVAS: VISION RAG &amp; STRUCTURAL EVIDENCE" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>

                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="14">
                                <TextBox Text="{x:Bind ViewModel.VisualEvidenceMarkdown, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas, Cascadia Code"
                                         FontSize="12"
                                         AcceptsReturn="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- CARD 4: Retrieved Multi-Modal Evidence Passages & Visual Artifacts -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20"
                            Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.HasResults), Mode=OneWay}">
                        <Expander Header="Retrieved Multi-Modal Evidence Passages (Ranked by Hybrid RRF)" HorizontalAlignment="Stretch" IsExpanded="False">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.RetrievedChunks, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="10" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:RetrievedChunkDto">
                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,10">
                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{x:Bind EvidenceTypeBadge}" FontSize="10" FontWeight="Bold" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind SectionHeader}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind DocName}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBox Text="{x:Bind Text}"
                                                         IsReadOnly="True"
                                                         FontFamily="Consolas, Cascadia Code"
                                                         FontSize="11"
                                                         AcceptsReturn="True"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         TextWrapping="Wrap"
                                                         MaxHeight="120" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Expander>
                    </Border>

                    <!-- Empty State Welcome Guide -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="32"
                            Visibility="{x:Bind local:MainPage.InvertBoolToVisibility(ViewModel.HasResults), Mode=OneWay}">
                        <StackPanel HorizontalAlignment="Center" Spacing="16" MaxWidth="500">
                            <FontIcon Glyph="&#xE95A;" FontSize="48" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Welcome to Privreach OS Workstation"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       TextAlignment="Center"
                                       FontWeight="Bold" />
                            <TextBlock Text="A zero-trust, 100% offline scientific intelligence operating system. Ingest your textbooks, research papers, or clinical datasets, then execute grounded queries with automated adversarial fact-checking."
                                       TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                                <Button Content="Ingest PDF Document" Click="IngestButton_Click" Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="Try 'Ideal Gas P' Query" Tag="Calculate the pressure of 2 moles of ideal gas occupying 0.05 m³ at 350 Kelvin using P = nRT / V." Click="SampleChip_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- =============================================================== -->
            <!-- PLANE 3: RIGHT - CLAIM VERIFICATION MATRIX & SYNCHRONIZED PDF -->
            <!-- =============================================================== -->
            <Grid Grid.Column="2"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1,0,0,0"
                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <!-- Row 0: Claim Verification Matrix List (45%) -->
                    <RowDefinition Height="340" MinHeight="220" />
                    <!-- Row 1: Synchronized PDF Viewer (55%) -->
                    <RowDefinition Height="*" MinHeight="260" />
                </Grid.RowDefinitions>

                <!-- TOP: CLAIM VERIFICATION MATRIX -->
                <Border Grid.Row="0"
                        Padding="14,14,14,10"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Matrix Header & Grounding Score Bar -->
                        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CLAIM VERIFICATION MATRIX" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.GroundingScoreText, Mode=OneWay}" FontWeight="Bold" FontSize="11" Foreground="#4ade80" />
                            </Grid>
                            <ProgressBar Value="{x:Bind ViewModel.GroundingScore, Mode=OneWay}" Maximum="100" />
                        </StackPanel>

                        <!-- Claims List -->
                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.Claims, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedClaim, Mode=TwoWay}"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ClaimDto">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="0,3"
                                            Tapped="ClaimItem_Tapped">
                                        <StackPanel Spacing="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Status Badge -->
                                                <Border Background="#162e21" CornerRadius="4" Padding="4,2">
                                                    <TextBlock Text="{x:Bind StatusBadge}" FontSize="10" FontWeight="Bold" Foreground="#4ade80" />
                                                </Border>
                                                <!-- Cited Document / Page Jump Pill -->
                                                <Button Grid.Column="2"
                                                        Padding="4,2"
                                                        FontSize="10"
                                                        Click="ClaimButton_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE8A5;" FontSize="10" />
                                                        <TextBlock Text="{x:Bind CitationReference}" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <!-- Claim Proposition Text -->
                                            <TextBlock Text="{x:Bind Text}" FontSize="11" TextWrapping="Wrap" LineHeight="16" />

                                            <!-- Evidence Quote snippet if available -->
                                            <TextBlock Text="{x:Bind EvidenceQuote}"
                                                       FontSize="10" FontStyle="Italic"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- BOTTOM: SYNCHRONIZED PDF & EVIDENCE VIEWER -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- PDF Viewer Header Bar -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ActivePdfDocName, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Page" FontSize="11" />
                                    <TextBlock Text="{x:Bind ViewModel.ActivePdfPage, Mode=OneWay}" FontSize="11" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- WebView2 Hosting the Local PDF Stream with Synchronized Jump -->
                    <WebView2 x:Name="PdfWebView"
                              Grid.Row="1" />
                </Grid>
            </Grid>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="3"
                Padding="16,6"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Ctrl+K Command Palette  |  Zero Data Egress" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Page>
