                                         FontSize="12" FontFamily="Consolas, Cascadia Code" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Known Values:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                <TextBox Text="{x:Bind ViewModel.SolveVariablesText, Mode=TwoWay}"
                                         PlaceholderText="V=0.05, n=2.0, T=350.0"
                                         FontSize="12" FontFamily="Consolas, Cascadia Code" />
                            </StackPanel>

                            <Button Grid.Column="3"
                                    VerticalAlignment="Bottom"
                                    Height="32" Padding="14,0"
                                    Background="{StaticResource AccentBluePrimaryBrush}"
                                    Foreground="#FFFFFF" CornerRadius="6"
                                    Command="{x:Bind ViewModel.SolveInteractiveEquationCommand}"
                                    IsEnabled="{x:Bind local:MainPage.Not(ViewModel.IsSolving), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE946;" FontSize="12" />
                                    <TextBlock Text="Compute Solution" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Solution Output Display -->
                        <Border Background="{StaticResource SurfaceSubtleGreyBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock Text="COMPUTED SOLUTION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedTertiaryBrush}" />
                                    <ProgressRing Width="14" Height="14" HorizontalAlignment="Right" IsActive="{x:Bind ViewModel.IsSolving, Mode=OneWay}" />
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.SolveResultText, Mode=OneWay}"
                                           FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBluePrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SolveFormulaLatex, Mode=OneWay}"
                                           FontSize="12" FontFamily="Consolas, Cascadia Code" Foreground="{StaticResource TextNavyPrimaryBrush}"
                                           Visibility="{x:Bind local:MainPage.StringNotEmptyToVisibility(ViewModel.SolveFormulaLatex), Mode=OneWay}" />
                                <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10"
                                        Visibility="{x:Bind local:MainPage.StringNotEmptyToVisibility(ViewModel.SolveCodeExecuted), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.SolveCodeExecuted, Mode=OneWay}"
                                               FontSize="11" FontFamily="Consolas, Cascadia Code" Foreground="{StaticResource TextSlateSecondaryBrush}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ======================================================== -->
        <!-- VIEW: ARTIFACTS (SelectedNavSection == 'Artifacts')      -->
        <!-- ======================================================== -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="20,16,20,16"
                      Visibility="{x:Bind local:MainPage.NavSectionToVisibility(ViewModel.SelectedNavSection, 'Artifacts'), Mode=OneWay}">
            <StackPanel Spacing="16">
                <!-- Artifacts Header Card -->
                <Border Style="{StaticResource SkeuoCardBorderStyle}" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Scientific Provenance &amp; Artifact Ledger" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                            <TextBlock Text="Immutable audit trail of calculated formulas, execution traces, and verified proofs." FontSize="11" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Padding="10,6" CornerRadius="6" Background="{StaticResource SurfaceSubtleGreyBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                Command="{x:Bind ViewModel.RefreshArtifactsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource AccentBluePrimaryBrush}" />
                                <TextBlock Text="Refresh Ledger" FontSize="11" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Artifacts List -->
                <TextBlock Text="VERIFIED ARTIFACTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Artifacts, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ArtifactDto">
                            <Border Style="{StaticResource SkeuoCardBorderStyle}" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="📜" FontSize="14" />
                                            <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                            <Border Background="{StaticResource AccentBluePillFillBrush}" CornerRadius="4" Padding="6,1">
                                                <TextBlock Text="{x:Bind ArtifactType}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBluePrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{StaticResource TextSlateSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ArtifactId}" FontSize="10" FontFamily="Consolas, Cascadia Code" Foreground="{StaticResource TextMutedTertiaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ======================================================== -->
        <!-- VIEW: SETTINGS (SelectedNavSection == 'Settings')        -->
        <!-- ======================================================== -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="20,16,20,16"
                      Visibility="{x:Bind local:MainPage.NavSectionToVisibility(ViewModel.SelectedNavSection, 'Settings'), Mode=OneWay}">
            <StackPanel Spacing="16">
                <!-- Settings Header Card -->
                <Border Style="{StaticResource SkeuoCardBorderStyle}" Padding="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Workstation Preferences &amp; Air-Gap Configuration" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                        <TextBlock Text="Inspect local privacy boundaries, model engines, and zero-trust OTA updater." FontSize="11" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Model Engine Selection Card -->
                <Border Style="{StaticResource SkeuoCardBorderStyle}" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Text="LOCAL INFERENCE ENGINE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Active Synthesis Model:" FontSize="11" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableModels, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedSynthesisModel, Mode=OneWay}"
                                          SelectionChanged="ModelComboBox_SelectionChanged"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Height="32" CornerRadius="6"
                                    Background="{StaticResource SurfaceSubtleGreyBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    Command="{x:Bind ViewModel.StartOllamaCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{StaticResource AccentBluePrimaryBrush}" />
                                    <TextBlock Text="Trigger Ollama" FontSize="11" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Air-Gap Zero Trust Audit Card -->
                <Border Style="{StaticResource SkeuoCardBorderStyle}" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Text="AIR-GAP ZERO-TRUST SECURITY AUDIT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                        <Grid RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="External Network Egress Block:" FontSize="12" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource StatusGreenFillBrush}" CornerRadius="4" Padding="8,2">
                                <TextBlock Text="ENFORCED (0 B/s)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource StatusGreenBrush}" />
                            </Border>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Localhost Bind Security (127.0.0.1):" FontSize="12" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource StatusGreenFillBrush}" CornerRadius="4" Padding="8,2">
                                <TextBlock Text="VERIFIED LOCAL ONLY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource StatusGreenBrush}" />
                            </Border>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Model Execution Layer:" FontSize="12" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                            <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource AccentBluePillFillBrush}" CornerRadius="4" Padding="8,2">
                                <TextBlock Text="GGUF / Ollama CPU+GPU" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBluePrimaryBrush}" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- OTA Update Manager Card -->
                <Border Style="{StaticResource SkeuoCardBorderStyle}" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Text="OTA SYSTEM UPDATES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.UpdaterNotificationText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextNavyPrimaryBrush}"
                                   Visibility="{x:Bind local:MainPage.StringNotEmptyToVisibility(ViewModel.UpdaterNotificationText), Mode=OneWay}" />
                        <Button Padding="14,8" CornerRadius="6" Background="{StaticResource AccentBluePrimaryBrush}" Foreground="#FFFFFF"
                                Command="{x:Bind ViewModel.CheckForUpdatesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                <TextBlock Text="Check for System Updates" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ======================================================== -->
        <!-- PANEL 3: RIGHT CONTEXTUAL CHAT & SYSTEM TOOLS            -->
        <!-- ======================================================== -->
        <Border Grid.Column="2"
                Background="{StaticResource CanvasBackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1,0,0,0"
                Padding="16,14,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Chat & Synthesis Stream (*) -->
                    <RowDefinition Height="*" />
                    <!-- Prompt Input Container (Auto) -->
                    <RowDefinition Height="Auto" />
                    <!-- Quick System Tools (Auto) -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- SCROLLABLE RESEARCH CHAT CONVERSATION -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <StackPanel Spacing="14">
                        <!-- User Query Bubble -->
                        <Border Background="{StaticResource SurfaceWhiteBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,12">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentBluePrimaryBrush}">
                                        <TextBlock Text="U" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Researcher Inquiry" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextNavyPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="{x:Bind ViewModel.ChatQueryText, Mode=OneWay}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           LineHeight="18"
                                           Foreground="{StaticResource TextNavyPrimaryBrush}" />

                                <!-- Ingested Documents / Attachment Chips -->
                                <ItemsControl ItemsSource="{x:Bind ViewModel.AttachedFiles, Mode=OneWay}" Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Background="{StaticResource SurfaceSubtleGreyBrush}"
                                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="6,2">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="📄" FontSize="10" />
                                                    <TextBlock Text="{x:Bind}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Multi-Stage Processing Wave Indicator -->
                        <Border Background="{StaticResource SurfaceWhiteBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="COMPUTATIONAL PIPELINE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedTertiaryBrush}" />
                                    <ProgressRing Width="12" Height="12"
                                                  IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                                  HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Progression Pills Stream -->
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                        <!-- Stage 1: analyzing -->
                                        <Border CornerRadius="4" Padding="5,2"
                                                Background="{x:Bind local:MainPage.StageToBadgeBrush(ViewModel.ProcessingWaveStage, 1), Mode=OneWay}">
                                            <TextBlock Text="analyzing" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{x:Bind local:MainPage.StageToBadgeForeground(ViewModel.ProcessingWaveStage, 1), Mode=OneWay}" />
                                        </Border>
                                        <TextBlock Text="→" FontSize="9" Foreground="{StaticResource TextMutedTertiaryBrush}" VerticalAlignment="Center" />

                                        <!-- Stage 2: parsing -->
                                        <Border CornerRadius="4" Padding="5,2"
                                                Background="{x:Bind local:MainPage.StageToBadgeBrush(ViewModel.ProcessingWaveStage, 2), Mode=OneWay}">
                                            <TextBlock Text="parsing" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{x:Bind local:MainPage.StageToBadgeForeground(ViewModel.ProcessingWaveStage, 2), Mode=OneWay}" />
                                        </Border>
                                        <TextBlock Text="→" FontSize="9" Foreground="{StaticResource TextMutedTertiaryBrush}" VerticalAlignment="Center" />

                                        <!-- Stage 3: computing -->
                                        <Border CornerRadius="4" Padding="5,2"
                                                Background="{x:Bind local:MainPage.StageToBadgeBrush(ViewModel.ProcessingWaveStage, 3), Mode=OneWay}">
                                            <TextBlock Text="computing" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{x:Bind local:MainPage.StageToBadgeForeground(ViewModel.ProcessingWaveStage, 3), Mode=OneWay}" />
                                        </Border>
                                        <TextBlock Text="→" FontSize="9" Foreground="{StaticResource TextMutedTertiaryBrush}" VerticalAlignment="Center" />

                                        <!-- Stage 4: visualizing -->
                                        <Border CornerRadius="4" Padding="5,2"
                                                Background="{x:Bind local:MainPage.StageToBadgeBrush(ViewModel.ProcessingWaveStage, 4), Mode=OneWay}">
                                            <TextBlock Text="visualizing" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{x:Bind local:MainPage.StageToBadgeForeground(ViewModel.ProcessingWaveStage, 4), Mode=OneWay}" />
                                        </Border>
                                        <TextBlock Text="→" FontSize="9" Foreground="{StaticResource TextMutedTertiaryBrush}" VerticalAlignment="Center" />

                                        <!-- Stage 5: verifying -->
                                        <Border CornerRadius="4" Padding="5,2"
                                                Background="{x:Bind local:MainPage.StageToBadgeBrush(ViewModel.ProcessingWaveStage, 5), Mode=OneWay}">
                                            <TextBlock Text="verifying" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{x:Bind local:MainPage.StageToBadgeForeground(ViewModel.ProcessingWaveStage, 5), Mode=OneWay}" />
                                        </Border>
                                        <TextBlock Text="→" FontSize="9" Foreground="{StaticResource TextMutedTertiaryBrush}" VerticalAlignment="Center" />

                                        <!-- Stage 6: generating -->
                                        <Border CornerRadius="4" Padding="5,2"
                                                Background="{x:Bind local:MainPage.StageToBadgeBrush(ViewModel.ProcessingWaveStage, 6), Mode=OneWay}">
                                            <TextBlock Text="generating" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{x:Bind local:MainPage.StageToBadgeForeground(ViewModel.ProcessingWaveStage, 6), Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Privreach AI Synthesis Response Bubble -->
                        <Border Background="{StaticResource SurfaceWhiteBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,12">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentBluePillFillBrush}">
                                        <TextBlock Text="P" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBluePrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Privreach Intelligence" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextNavyPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Background="{x:Bind local:MainPage.StatusFillBrush(ViewModel.HasResults), Mode=OneWay}"
                                            BorderBrush="{x:Bind local:MainPage.StatusStrokeBrush(ViewModel.HasResults), Mode=OneWay}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="4,1">
                                        <TextBlock Text="{x:Bind local:MainPage.StatusBadgeText(ViewModel.HasResults), Mode=OneWay}" FontSize="9" FontWeight="Bold" Foreground="{x:Bind local:MainPage.StatusTextBrush(ViewModel.HasResults), Mode=OneWay}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{x:Bind ViewModel.ChatSynthesisText, Mode=OneWay}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"
                                           LineHeight="18"
                                           Foreground="{StaticResource TextNavyPrimaryBrush}" />

                                <!-- Citation Reference Pill -->
                                <Button Padding="6,3" CornerRadius="6"
                                        Background="{StaticResource SurfaceSubtleGreyBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        Tag="Results" Click="TabButton_Click"
                                        Visibility="{x:Bind local:MainPage.StringNotEmptyToVisibility(ViewModel.PrimaryCitationText), Mode=OneWay}"
                                        ToolTipService.ToolTip="View source evidence in PDF viewer">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{x:Bind ViewModel.PrimaryCitationText, Mode=OneWay}" FontSize="10" Foreground="{StaticResource AccentBluePrimaryBrush}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- PROMPT INPUT CONTAINER -->
                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceWhiteBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,8"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox x:Name="ChatInputBox"
                                 Grid.Row="0"
                                 Height="54"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 PlaceholderText="Ask follow-up question or request simulation adjustment..."
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="12"
                                 Padding="0"
                                 KeyDown="ChatInputBox_KeyDown" />

                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Attachment Button -->
                            <Button Grid.Column="0"
                                    Width="30" Height="30"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="IngestButton_Click"
                                    ToolTipService.ToolTip="Attach PDF or Video">
                                <FontIcon Glyph="&#xE723;" FontSize="13" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                            </Button>

                            <!-- Send Inquiry Button -->
                            <Button Grid.Column="2"
                                    Width="32" Height="32"
                                    Padding="0"
                                    CornerRadius="6"
                                    Background="{StaticResource AccentBluePrimaryBrush}"
                                    BorderThickness="0"
                                    Click="ChatSend_Click"
                                    IsEnabled="{x:Bind local:MainPage.Not(ViewModel.IsBusy), Mode=OneWay}"
                                    ToolTipService.ToolTip="Execute Research Inquiry">
                                <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="#FFFFFF" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- QUICK SYSTEM TOOLS CARDS -->
                <StackPanel Grid.Row="2" Spacing="6">
                    <TextBlock Text="SYSTEM INGESTION TOOLS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedTertiaryBrush}" Margin="2,0,0,0" />

                    <!-- PDF Ingester Card -->
                    <Border Background="{StaticResource SurfaceWhiteBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="1">
                                <TextBlock Text="PDF Ingester" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                <TextBlock Text="Local OCR &amp; Semantic Chunking" FontSize="10" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource StatusGreenBrush}" />
                                <TextBlock Text="Ready" FontSize="10" Foreground="{StaticResource StatusGreenBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Video Ingester Card -->
                    <Border Background="{StaticResource SurfaceWhiteBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="1">
                                <TextBlock Text="Video Ingester" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextNavyPrimaryBrush}" />
                                <TextBlock Text="Frame Extraction &amp; Vision RAG" FontSize="10" Foreground="{StaticResource TextSlateSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource StatusGreenBrush}" />
                                <TextBlock Text="Ready" FontSize="10" Foreground="{StaticResource StatusGreenBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
